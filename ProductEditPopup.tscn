[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ProductEditPopup.gd" id="1"]

[node name="ProductEditPopup" type="Window"]
title = "Edit Product"
initial_position = 2
size = Vector2i(600, 1000)
visible = false
script = ExtResource("1")

[node name="ScrollContainer" type="ScrollContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
